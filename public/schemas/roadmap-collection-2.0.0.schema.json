{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap-collection-2.0.0.schema.json",
  "title": "Quantum hardware roadmap collection",
  "description": "Hardware roadmaps as their sources reported them, in plain units. Calculator assumptions (physical-to-logical ratio, its yearly change, extrapolation) are not part of this format.",
  "type": "object",
  "required": ["schemaVersion", "kind", "roadmaps"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "kind": { "const": "roadmap-collection" },
    "exportedAt": { "type": "string", "format": "date" },
    "roadmaps": { "type": "array", "items": { "$ref": "#/$defs/roadmap" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "published": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" }
      },
      "anyOf": [{ "required": ["url"] }, { "required": ["citation"] }],
      "additionalProperties": false
    },
    "provenance": { "enum": ["vendor-published", "third-party", "user-entered"] },
    "metricValue": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": { "type": "number" },
            "low": { "type": "number" },
            "high": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "description": "Open list of metrics. Known names and units: physicalQubits, logicalQubits (qubits); twoQubitGateError, singleQubitGateError, readoutError, logicalErrorRate (probability, 0 to 1); gateTimeNs (ns); coherenceTimeUs (us); logicalClockRateHz (Hz); systemCostUsd (USD). Other names are allowed.",
      "properties": {
        "physicalQubits": { "$ref": "#/$defs/metricValue" },
        "logicalQubits": { "$ref": "#/$defs/metricValue" },
        "twoQubitGateError": { "$ref": "#/$defs/metricValue" },
        "singleQubitGateError": { "$ref": "#/$defs/metricValue" },
        "readoutError": { "$ref": "#/$defs/metricValue" },
        "gateTimeNs": { "$ref": "#/$defs/metricValue" },
        "coherenceTimeUs": { "$ref": "#/$defs/metricValue" },
        "logicalErrorRate": { "$ref": "#/$defs/metricValue" },
        "logicalClockRateHz": { "$ref": "#/$defs/metricValue" },
        "systemCostUsd": { "$ref": "#/$defs/metricValue" }
      },
      "additionalProperties": { "$ref": "#/$defs/metricValue" }
    },
    "dataPoint": {
      "type": "object",
      "required": ["year", "status", "metrics"],
      "properties": {
        "year": { "type": "integer" },
        "status": { "enum": ["demonstrated", "projected"] },
        "system": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "roadmap": {
      "type": "object",
      "required": ["title", "organization", "modality", "source", "dataPoints"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "modality": { "enum": ["superconducting", "trapped-ion", "neutral-atom", "semiconductor", "photonic", "topological", "other"] },
        "technology": { "type": "string" },
        "qecScheme": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "source": { "$ref": "#/$defs/source" },
        "notes": { "type": "string" },
        "dataPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dataPoint" } }
      },
      "additionalProperties": false
    }
  }
}
